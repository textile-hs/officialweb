---
// src/layouts/Layout.astro
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import type { Translations } from '../i18n/types';

interface Props {
  t: Translations;
  lang: 'zh' | 'en';
  title: string;
  description: string;
  canonicalUrl: string;
  alternateUrl: string;
  transparentNav?: boolean;
}

const { t, lang, title, description, canonicalUrl, alternateUrl, transparentNav = false } = Astro.props;
const alternateLang = lang === 'zh' ? 'en' : 'zh';
const bcp47: Record<string, string> = { zh: 'zh-CN', en: 'en-US' };
const xDefault = new URL('/zh/', Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={bcp47[lang]} href={canonicalUrl} />
    <link rel="alternate" hreflang={bcp47[alternateLang]} href={alternateUrl} />
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans text-[#333333] bg-white">
    <Nav t={t} lang={lang} alternateUrl={alternateUrl} transparentNav={transparentNav} />
    <main class="pt-16">
      <slot />
    </main>
    <Footer t={t} />
  </body>
</html>
