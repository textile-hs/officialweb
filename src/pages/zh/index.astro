---
// src/pages/zh/index.astro
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import t from '../../i18n/zh';
import { Image } from 'astro:assets';
import heroImg from '../../assets/images/factory-hero.jpg';
import homeIntroImg from '../../assets/images/home-intro.png';
import prod1 from '../../assets/images/product-waffle.png';
import prod2 from '../../assets/images/product-rib.png';
import prod3 from '../../assets/images/product-jacquard.png';
import prod4 from '../../assets/images/product-single-jersey.png';

const products = [
  { img: prod1, ...t.products.items[0] },
  { img: prod2, ...t.products.items[1] },
  { img: prod3, ...t.products.items[2] },
  { img: prod4, ...t.products.items[3] },
];
---

<Layout
  t={t}
  lang="zh"
  title="佛山市鸿尚纺织有限公司 — 专业针织面料"
  description="鸿尚纺织专业针织面料研发、生产、定制。主营华夫格面料、坑条罗纹、针织提花、单面布，支持OEM/ODM来样加工，客户遍及海内外。"
  canonicalUrl="https://www.hongstex.shop/zh/"
  alternateUrl="https://www.hongstex.shop/en/"
  keywords="针织面料,华夫格面料,坑条罗纹,针织提花,单面布,OEM面料定制,ODM纺织,佛山纺织厂,鸿尚纺织"
  transparentNav={true}
>
  <!-- Hero -->
  <h1 class="sr-only">{t.home.heroTitle}</h1>
  <section class="-mt-16">
    <Image src={heroImg} alt="鸿尚纺织生产基地" class="w-full h-auto block" width={1681} height={935} />
  </section>

  <!-- Products preview -->
  <section class="py-16 bg-white">
    <div class="max-w-content mx-auto px-6">
      <h2 class="text-3xl font-bold text-center text-primary mb-10">{t.home.productsTitle}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {products.map(p => <ProductCard name={p.name} description={p.description} img={p.img} />)}
      </div>
      <div class="text-center mt-8">
        <a href="/zh/products/" class="border-2 border-primary text-primary px-8 py-3 rounded font-medium hover:bg-primary hover:text-white transition-colors inline-block">
          {t.home.productsViewAll}
        </a>
      </div>
    </div>
  </section>

  <!-- Company intro -->
  <section class="bg-[#2c2826] text-white overflow-hidden">
    <div class="flex flex-col md:flex-row">
      <div class="md:w-1/2">
        <Image src={homeIntroImg} alt="鸿尚纺织企业简介" class="w-full h-auto block" width={1335} height={1178} />
      </div>
      <div class="md:w-1/2 flex flex-col justify-center px-10 lg:px-16 py-12">
        <h2 class="text-2xl font-bold text-accent mb-3">{t.home.introTitle}</h2>
        <div class="w-10 h-0.5 bg-accent mb-6"></div>
        <p class="text-gray-300 leading-relaxed text-sm mb-10">{t.about.intro}</p>
        <div class="grid grid-cols-2 gap-x-8 gap-y-6">
          {t.home.statsItems.map(stat => (
            <div class="border-l-2 border-accent pl-4">
              <div class="text-2xl font-bold text-accent">{stat.value}</div>
              <div class="text-xs text-gray-400 mt-0.5">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
